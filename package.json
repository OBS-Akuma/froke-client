{
  "name": "froke-client",
  "version": "1.1.18",
  "description": "Electron client for Kirka.io",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/obs-akuma/froke-client.git"
  },
  "keywords": [],
  "author": "Smudgy.store",
  "license": "ISC",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "v8-compile-cache": "^2.4.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "build": {
    "appId": "com.smudgy.froke-client",
    "productName": "Froke Client",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/img/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/img/icon.png"
    }
  }
}
